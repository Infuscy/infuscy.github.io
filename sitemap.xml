---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
  </url>
  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
  </url>
  {% endfor %}
  <url>
    <loc>{{ site.url }}/privacy/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/novel/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/fire-to-future/</loc>
  </url>
  {% for ch in site.data.fire_to_future_chapters %}
  <url>
    <loc>{{ site.url }}/fire-to-future/{{ ch.file }}</loc>
  </url>
  {% endfor %}
</urlset>
